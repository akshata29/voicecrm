# VoiceCRM configuration. Copy to .env (never commit .env).
# Every live Azure service has a mock/local fallback. With VOICECRM_DEMO_MODE=true (default),
# a service whose live settings are missing silently falls back to its mock/local adapter,
# and GET /api/v1/config reports which services are live.

VOICECRM_DEMO_MODE=true

# --- Adapter modes -----------------------------------------------------------------------------
# transcription: mock | azure_speech
VOICECRM_TRANSCRIPTION_MODE=mock
# extraction engine: rules (no LLM) | foundry (LLM) | hybrid (rules candidates + LLM)
VOICECRM_LLM_MODE=rules
# catalogue search: local | azure_search
VOICECRM_SEARCH_MODE=local
# PII detection: local | azure_language
VOICECRM_PII_MODE=local
# CRM: local (SQLite simulator) | dataverse
VOICECRM_CRM_MODE=local
# transcript/audio vault: local | azure_blob
VOICECRM_VAULT_MODE=local

# --- Azure authentication ------------------------------------------------------------------------
# entra  = DefaultAzureCredential (az login / managed identity) - recommended, no secrets
# key    = API keys below (simplest for a demo; use entra / managed identity in production)
# Some tenants (Microsoft's MCAPS policy, for one) force local auth off on every Cognitive Services / Foundry
# resource, so keys are rejected there: use entra and give your identity "Cognitive Services User" and
# "Cognitive Services OpenAI User" on the resource.
VOICECRM_AZURE_AUTH=entra

# --- Azure Speech (fast transcription) -----------------------------------------------------------
# Entra auth requires the custom-domain endpoint, e.g. https://<resource>.cognitiveservices.azure.com
VOICECRM_SPEECH_ENDPOINT=
VOICECRM_SPEECH_KEY=

# --- Microsoft Foundry / Azure OpenAI model deployment --------------------------------------------
VOICECRM_FOUNDRY_ENDPOINT=
VOICECRM_FOUNDRY_DEPLOYMENT=
VOICECRM_FOUNDRY_KEY=

# --- Azure AI Language (PII) ---------------------------------------------------------------------
VOICECRM_LANGUAGE_ENDPOINT=
VOICECRM_LANGUAGE_KEY=

# --- Azure AI Search (product catalogue index) ---------------------------------------------------
VOICECRM_SEARCH_ENDPOINT=
VOICECRM_SEARCH_INDEX=voicecrm-catalogue
VOICECRM_SEARCH_KEY=

# --- Azure Blob (vault) --------------------------------------------------------------------------
VOICECRM_BLOB_ACCOUNT_URL=
VOICECRM_BLOB_CONTAINER_AUDIO=voicecrm-audio
VOICECRM_BLOB_CONTAINER_TRANSCRIPTS=voicecrm-transcripts

# --- Dataverse / Dynamics 365 (non-production environment only; never MSX) ------------------------
VOICECRM_DATAVERSE_URL=
VOICECRM_DATAVERSE_FIELD_PROFILE=standard

# --- App behaviour -------------------------------------------------------------------------------
VOICECRM_DEFAULT_MARKET=US
VOICECRM_DEFAULT_BUSINESS_LINE=professional_buyer
VOICECRM_CORS_ORIGINS=http://localhost:5173
VOICECRM_SPA_DIR=
VOICECRM_ZOOM_WEBHOOK_SECRET=

# --- Throughput (bulk runs; docs/live-demo.md, scenario C) ---------------------------------------
# Calls processed at once, and requests the Language client keeps in flight across all calls.
# scripts\run_bulk_backend.bat sets both to 32. Throughput is capped by the deployment's quota: ~280 calls/min measured at 32 on
# an 800K-TPM gpt-5.4-mini deployment (about 3.7k tokens per call), ~370 calls/min at 64 on a 5M-TPM one.
VOICECRM_MAX_CONCURRENCY=8
VOICECRM_PII_CONCURRENCY=8
# Pack transcript segments into Language documents of up to this many characters (0 = one document per segment).
# Cuts billed text records about 7x with no detection lost.
VOICECRM_PII_PACK_CHARS=4000
# Most calls one load test may send from the Live demo page (scenario C). Each call is billed on live services.
VOICECRM_LOAD_MAX_CALLS=2000
# Entra only: the tenant that owns the Azure resources, when it is not your `az login` default tenant.
VOICECRM_AZURE_TENANT_ID=

# --- Microsoft Teams live ingestion (Graph, app-only; docs/live-demo.md, scenario B) --------------
# off | poll (needs no public URL) | webhook (needs VOICECRM_TEAMS_PUBLIC_BASE_URL)
VOICECRM_TEAMS_MODE=off
VOICECRM_TEAMS_TENANT_ID=
VOICECRM_TEAMS_CLIENT_ID=
VOICECRM_TEAMS_CLIENT_SECRET=
# comma-separated UPNs or object ids of the sellers who host the meetings
VOICECRM_TEAMS_ORGANIZERS=
VOICECRM_TEAMS_POLL_SECONDS=20
VOICECRM_TEAMS_LOOKBACK_MINUTES=480
# webhook mode only: an https URL Graph can reach (e.g. a dev tunnel to this API) and any long random string
VOICECRM_TEAMS_PUBLIC_BASE_URL=
VOICECRM_TEAMS_CLIENT_STATE=

# --- Phone line (Azure Communication Services answers and records calls to the VoiceCRM line; docs/phone-line.md) ---
# off | acs
VOICECRM_PHONE_MODE=off
# https://<resource>.<geo>.communication.azure.com (Entra sign-in, the default), or a connection string (a secret) instead
VOICECRM_PHONE_ACS_ENDPOINT=
VOICECRM_PHONE_ACS_CONNECTION_STRING=
# ARM id of that resource; `phone subscribe` creates the Event Grid subscriptions on it
VOICECRM_PHONE_ACS_RESOURCE_ID=
# the https URL of the dev tunnel to the INGRESS port (scripts\run_phone_tunnel.bat; never tunnel the API port) and a long random
# string that becomes part of the Event Grid URL (at least 24 characters)
VOICECRM_PHONE_PUBLIC_BASE_URL=
VOICECRM_PHONE_WEBHOOK_SECRET=
# the small listener that serves ONLY the phone webhooks (0 = off)
VOICECRM_PHONE_INGRESS_HOST=127.0.0.1
VOICECRM_PHONE_INGRESS_PORT=8011
# shown on the dial pad (empty = "VoiceCRM line"); the identity the browser dialer calls is created on first use and remembered
VOICECRM_PHONE_DISPLAY_NUMBER=
VOICECRM_PHONE_LINE_IDENTITY=
# more recipients to answer, comma-separated raw ids (e.g. the Teams resource account of a real number, 28:orgid:<object id>)
VOICECRM_PHONE_ACCEPT_TO=
# who to ring: teams:<object id or UPN>, acs:<raw id>, or empty for the seller console in the browser (Live demo, scenario D)
VOICECRM_PHONE_SELLER=
VOICECRM_PHONE_SELLER_NAME=
VOICECRM_PHONE_SELLER_EMAIL=
# the Foundry / AI Services endpoint Communication Services uses to speak the notice (its identity needs Cognitive Services User)
VOICECRM_PHONE_COGNITIVE_ENDPOINT=
VOICECRM_PHONE_NOTICE_VOICE=en-US-JennyNeural
# hang up instead of recording when the notice cannot be played
VOICECRM_PHONE_REQUIRE_NOTICE=true
VOICECRM_PHONE_RING_SECONDS=25
VOICECRM_PHONE_MAX_CALL_MINUTES=30
VOICECRM_PHONE_VOICEMAIL_SECONDS=180
# a recording with less speech than this (seconds of speech-level audio, either party) is a hang-up or a silent voicemail: it is
# shown as a missed call and not sent to the pipeline. 0 sends every recording on.
VOICECRM_PHONE_MIN_SPEECH_SECONDS=1.5
