{
  "name": "VoiceCRM Capture",
  "short_name": "VoiceCRM",
  "description": "Record an in-person conversation (even offline); VoiceCRM turns it into a CRM-ready note, products and tasks. Synthetic demo data only.",
  "id": "/capture",
  "start_url": "/capture",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
